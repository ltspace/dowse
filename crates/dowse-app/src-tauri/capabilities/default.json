{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default",
    "global-shortcut:default",
    "autostart:default",
    "dialog:default",
    "clipboard-manager:default"
  ]
}
